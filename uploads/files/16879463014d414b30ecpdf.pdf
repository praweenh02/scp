         <photoshop:TextLayers>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>The IPLOOK 5G Core Network mainly include AUSF, AMF, UDM, SMF, </photoshop:LayerName>
                  <photoshop:LayerText>The IPLOOK 5G Core Network mainly include AUSF, AMF, UDM, SMF, UPF,PCF etc.  It enables rapid data forwarding speed, quick iteration and owns high service levels.  It could co-exist with 3G and 4G mobile network with some NEs are combined. </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Application scenario</photoshop:LayerName>
                  <photoshop:LayerText>Application scenario</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Railway</photoshop:LayerName>
                  <photoshop:LayerText>Railway</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Power Grid</photoshop:LayerName>
                  <photoshop:LayerText>Power Grid</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Mining Industry</photoshop:LayerName>
                  <photoshop:LayerText>Mining Industry</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Operator</photoshop:LayerName>
                  <photoshop:LayerText>Operator</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Earth Station of Satellite</photoshop:LayerName>
                  <photoshop:LayerText>Earth Station of Satellite</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Education</photoshop:LayerName>
                  <photoshop:LayerText>Education</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>IPLOOK has already released the first 5GC version which include</photoshop:LayerName>
                  <photoshop:LayerText>IPLOOK has already released the first 5GC version which includes AMF,AMF, AUSF,UDM,UPF.   The 5GC has been done IOT test with multiple gNodeB vendors and completed the 5G end-to-end services like data service. Besides, IPLOOKâ€™s 5GC supports deployment in parts, with which its NEs are able to interconnect with 5GC from other vendor easily.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Roadmap</photoshop:LayerName>
                  <photoshop:LayerText>Roadmap</photoshop:LayerText>
               </rdf:li>
            </rdf:Bag>
         </photoshop:TextLayers>
